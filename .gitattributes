# 개행 문자 정책
# Prettier 가 endOfLine: "lf" 로 포맷하므로 git 의 CRLF 자동 변환을 막는다.
# 이 설정이 없으면 Windows 에서 체크아웃 시 CRLF 로 바뀌어
# prettier --check 가 계속 실패하는 무한 루프에 빠진다.

# 기본: 텍스트 파일은 저장소에 LF 로 정규화하고 작업 트리에도 LF 로 둔다
* text=auto eol=lf

# husky 훅은 sh 로 실행되므로 반드시 LF 여야 한다
.husky/** text eol=lf

# Windows 전용 스크립트는 CRLF 를 유지한다
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리 파일은 변환하지 않는다
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
